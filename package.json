{
  "name": "wanderlog",
  "version": "1.0.0",
  "description": "Family travel tracker: each traveller colours the countries they've visited on a shared world map. Express + EJS + PostgreSQL.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@svg-maps/world": "^2.0.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
